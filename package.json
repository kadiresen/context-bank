{
  "name": "context-bank",
  "version": "1.1.0",
  "description": "A CLI tool to standardise AI context in projects.",
  "type": "module",
  "bin": {
    "context-bank": "./dist/index.js"
  },
  "scripts": {
    "build": "pnpm lint && tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write .",
    "prepublishOnly": "tsc"
  },
  "keywords": [
    "cli",
    "ai",
    "context",
    "developer-tools"
  ],
  "files": [
    "dist",
    "templates"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^10.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.57.0"
  }
}
