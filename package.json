{
  "name": "context-bank",
  "version": "2.0.0",
  "description": "Git-committed, tool-agnostic project context for AI agents. Retrieval-first.",
  "type": "module",
  "bin": {
    "context-bank": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadiresen/context-bank.git"
  },
  "author": "Kadir Esen",
  "scripts": {
    "build": "pnpm lint && tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write .",
    "prepublishOnly": "tsc"
  },
  "keywords": [
    "cli",
    "ai",
    "context",
    "developer-tools"
  ],
  "files": [
    "dist",
    "templates"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^10.0.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.11"
  }
}
